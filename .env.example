# URL backend API yang sudah di-deploy.
# Contoh: https://stockpulse-api.snapdeploy.xyz/api
# Tanpa env ini, frontend default ke http://localhost:8000/api (lokal)
VITE_API_BASE=http://localhost:8000/api

# ---- Supabase (opsional, untuk harga realtime) ----
# Project Settings → API. Wajib ketiganya untuk frontend realtime.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Backend env (dipakai di server, bukan Vite) ----
# Secret untuk tanda tangan JWT sesi (ganti dengan string acak panjang)
AUTH_SECRET=

# Resend untuk email verifikasi. API key dari https://resend.com
RESEND_API_KEY=
# Pengirim email (domain harus terverifikasi di Resend)
EMAIL_FROM=noreply@plotfinansial.com

# Supabase: URL yang sama dengan VITE_SUPABASE_URL, plus service role key.
# WAJIB untuk login/register/portfolio — tanpa ini endpoint auth membalas 503.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Supabase anon key untuk validasi token Google dari Supabase Auth
SUPABASE_ANON_KEY=

# ---- Twelve Data (opsional, alternatif Yahoo Finance) ----
# API key gratis dari https://twelvedata.com - 8 endpoint/day gratis
# Untuk stock dan forex data real-time
TWELVEDATA_API_KEY=

# ---- CoinMarketCap (untuk kripto) ----
# API key gratis dari https://coinmarketcap.com/api/ - 10,000 calls/month
CM_CMC_API_KEY=bd9baef79b0647e69ed5d5aa05a6a719